<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Paisa Pilot – Expense Manager</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f2fb;--card:#fff;--ink:#3b3558;--mut:#8a84a3;--line:#ebe5f5;--acc:#8b7ae0;--gold:#f2c97d;--pad:env(safe-area-inset-top,0px);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1e1b2e;--card:#292540;--ink:#efeaff;--mut:#a59fc4;--line:#3a3556;--acc:#b6a8ff}}
:root[data-theme="dark"]{--bg:#1e1b2e;--card:#292540;--ink:#efeaff;--mut:#a59fc4;--line:#3a3556;--acc:#b6a8ff}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100vh;background:linear-gradient(135deg,rgba(246,177,122,.28) 0%,rgba(240,143,180,.22) 35%,rgba(165,149,230,.26) 70%,rgba(125,184,232,.28) 100%),var(--bg);background-attachment:fixed;color:var(--ink);font:400 15px/1.5 'DM Sans',system-ui,sans-serif}
h1,h2,h3{font-family:'Bricolage Grotesque',system-ui,sans-serif;margin:0;letter-spacing:-.02em}
.wrap{max-width:1100px;margin:auto;padding:20px 16px 60px}
header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px}
h1{font-size:30px;font-weight:800;background:linear-gradient(90deg,#a595e6,#f08fb4 60%,#f6b17a);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
.sub{color:var(--mut);margin:0}
.grid{display:grid;gap:14px}
.stats{grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:18px;box-shadow:0 6px 20px rgba(139,122,224,.08)}
.stat b{display:block;font:800 26px 'Bricolage Grotesque',sans-serif}
.stat span{color:var(--mut);font-size:13px}
.main{grid-template-columns:1.6fr 1fr;margin-top:14px}
@media(max-width:820px){.main{grid-template-columns:1fr}}
.tabs{display:inline-flex;background:var(--bg);border-radius:12px;padding:3px}
.tabs button,.btn{font:500 14px 'DM Sans',sans-serif;border:0;cursor:pointer;border-radius:10px;padding:7px 14px;background:transparent;color:var(--mut)}
.tabs button.on{background:linear-gradient(135deg,#a595e6,#f08fb4);color:#fff}
.btn{background:linear-gradient(135deg,#a595e6,#f08fb4);color:#fff;padding:10px 18px;font-weight:700;box-shadow:0 4px 12px rgba(165,149,230,.3)}
.btn.ghost{background:linear-gradient(135deg,rgba(165,149,230,.16),rgba(125,184,232,.16));color:var(--ink);box-shadow:none}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
form{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
input,select{font:inherit;padding:10px 12px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--ink);width:100%}
.cats{display:flex;gap:8px;flex-wrap:wrap;grid-column:1/-1}
.cat{border:2px solid transparent;border-radius:14px;padding:8px 10px;cursor:pointer;background:var(--bg);display:flex;flex-direction:column;align-items:center;gap:2px;min-width:74px;font:500 12px 'DM Sans',sans-serif;color:var(--ink)}
.cat .ic{width:40px;height:40px;display:grid;place-items:center;font-size:21px}
.cat.on{border-color:var(--acc);background:linear-gradient(135deg,rgba(165,149,230,.2),rgba(240,143,180,.2))}
.ic{flex:none}
.s0{border-radius:50%}.s1{border-radius:12px}.s2{border-radius:14px 4px 14px 4px}.s3{border-radius:50% 50% 12px 12px}.s4{border-radius:4px 16px 4px 16px}.s5{border-radius:12px 12px 50% 50%}.s6{border-radius:8px;transform:rotate(-6deg)}.s7{border-radius:50% 12px}
.tx{display:flex;align-items:center;gap:12px;padding:9px 0;border-top:1px solid var(--line)}
.tx .ic{width:42px;height:42px;display:grid;place-items:center;font-size:21px}
.tx div.m{flex:1;min-width:0}.tx div.m small{color:var(--mut);display:block}
.tx b{font-family:'Bricolage Grotesque',sans-serif}
.x{background:none;border:0;color:var(--mut);cursor:pointer;font-size:16px}
.bar{height:8px;border-radius:5px;background:var(--bg);overflow:hidden;margin-top:4px}.bar i{display:block;height:100%}
.sg{border-left:5px solid;border-radius:6px 14px 14px 6px;padding:10px 12px;background:linear-gradient(90deg,rgba(165,149,230,.16),rgba(240,143,180,.06));margin-bottom:10px}
.sg b{display:block}.sg p{margin:2px 0 0;color:var(--mut);font-size:14px}
.chart{overflow-x:auto}
svg text{fill:var(--mut);font:11px 'DM Sans',sans-serif}
.empty{color:var(--mut);padding:14px 0}
[hidden]{display:none!important}
.nav{display:flex;gap:6px;overflow-x:auto;margin-bottom:16px;padding:5px;background:var(--card);border:1px solid var(--line);border-radius:18px;position:sticky;top:env(safe-area-inset-top,0px);z-index:5;box-shadow:0 6px 20px rgba(139,122,224,.1)}
.nav a{flex:1;text-align:center;white-space:nowrap;padding:9px 14px;border-radius:13px;color:var(--mut);text-decoration:none;font-weight:500}
.nav a.on{background:linear-gradient(135deg,#a595e6,#f08fb4);color:#fff}
.pg:not(.card){display:grid;gap:14px}
.fl{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:10px}
label{display:grid;gap:4px;font-size:13px}
textarea{font:inherit;width:100%;padding:10px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}
#alerts:not(:empty){margin-bottom:14px}
#alerts a,.sg a{color:var(--acc)}
#exp{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:9;max-width:520px;margin:auto}
#auth{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:20px;overflow:auto;background:linear-gradient(135deg,#f6b17a 0%,#f08fb4 35%,#a595e6 70%,#7db8e8 100%)}
#auth:before,#auth:after{content:'';position:absolute;border-radius:50%;filter:blur(60px);opacity:.55;background:#fff;width:40vmax;height:40vmax;animation:fl 14s ease-in-out infinite alternate;pointer-events:none}
#auth:before{top:-12vmax;left:-10vmax}
#auth:after{bottom:-14vmax;right:-10vmax;animation-delay:-7s;background:#ffe3f1}
@keyframes fl{to{transform:translate(40px,30px) scale(1.15)}}
.ac{position:relative;z-index:1;width:100%;max-width:400px;padding:28px;border-radius:28px;background:rgba(255,255,255,.74);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.8);box-shadow:0 20px 60px rgba(90,70,160,.25);color:#3b3558}
.ac h2{margin:4px 0 2px;font-size:28px;font-weight:800;background:linear-gradient(90deg,#a595e6,#f08fb4 60%,#f6b17a);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.ac label{margin-bottom:12px;color:#6b6585}
.ac input{background:rgba(255,255,255,.9);color:#3b3558;border-color:#e3dcf2;width:100%;box-sizing:border-box}
.ac .btn{width:100%}
.ac .btn.ghost{color:#3b3558}
.ac .tabs button{color:#8a84a3}
.ac .tabs button.on{color:#fff}
.pw{position:relative}
.pw input{padding-right:46px}
.pw button{position:absolute;right:6px;top:50%;transform:translateY(-50%);background:none;border:0;font-size:18px;cursor:pointer;padding:6px}
.err{color:#d9534f;min-height:20px;font-size:13px;margin:0 0 6px}
.note{text-align:center;font-size:12px;color:#8a84a3;margin:14px 0 0}
.ash{display:flex;position:relative;z-index:1;width:100%;max-width:880px;border-radius:32px;overflow:hidden;box-shadow:0 24px 70px rgba(90,70,160,.3);border:1px solid rgba(255,255,255,.6)}
.side{flex:1.1;padding:36px;color:#fff;background:linear-gradient(160deg,rgba(255,255,255,.28),rgba(255,255,255,.06));-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);display:flex;flex-direction:column;justify-content:center;gap:12px}
.side .art{width:170px}
.sh{font-size:30px;font-weight:800;line-height:1.15;text-shadow:0 2px 12px rgba(90,70,160,.25)}
.side p{margin:0;opacity:.95}
.side ul{list-style:none;margin:6px 0 0;padding:0;display:grid;gap:8px}
.side li{background:rgba(255,255,255,.24);padding:9px 14px;border-radius:14px;width:fit-content;font-weight:500}
.ash .ac{flex:1;max-width:none;border-radius:0;box-shadow:none;border:0;background:rgba(255,255,255,.9);display:flex;flex-direction:column;justify-content:center;padding:34px}
.ac input:focus{outline:none;box-shadow:none}
*{-webkit-tap-highlight-color:transparent}
.pwm{height:6px;border-radius:6px;background:#e9e3f5;overflow:hidden;margin:-4px 0 4px}
.pwm i{display:block;height:100%;width:0;transition:width .3s,background .3s}
#pm small{color:#8a84a3;display:block;margin-bottom:8px}
@keyframes shake{20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}
.sk{animation:shake .4s}
@media(max-width:760px){.ash{flex-direction:column;max-width:420px}.side{padding:18px;text-align:center;align-items:center}.side p,.side ul{display:none}.side .art{width:90px}.sh{font-size:22px}.ash .ac{padding:22px}}
@media(prefers-reduced-motion:reduce){#auth:before,#auth:after{animation:none}}
@keyframes up{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes bob{50%{transform:translateY(-10px)}}
@keyframes spin{to{transform:rotateY(360deg)}}
.pg,#stats,.main,#alerts>*,#hero{animation:up .5s ease both}
.card{transition:transform .25s,box-shadow .25s}
.card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(139,122,224,.2)}
.btn{transition:transform .15s,filter .2s}
.btn:hover{filter:brightness(1.06);transform:translateY(-1px)}
.btn:active{transform:scale(.97)}
.tx{transition:background .2s}
.hero{display:flex;align-items:center;gap:16px;justify-content:space-between;overflow:hidden;margin-bottom:14px;background:linear-gradient(120deg,rgba(246,177,122,.5),rgba(240,143,180,.4) 50%,rgba(165,149,230,.5)),var(--card)}
.hero h2{margin:0 0 4px;font-size:22px}
.hero .art{width:150px;flex:none}
.art svg{width:100%;height:auto;display:block;overflow:visible}
.fa{animation:bob 4s ease-in-out infinite}
.fb{animation:bob 5s ease-in-out -2s infinite}
.coin{animation:spin 3s linear infinite;transform-box:fill-box;transform-origin:center}
.fe{position:absolute;font-size:34px;font-style:normal;animation:bob 5s ease-in-out infinite;pointer-events:none}
@media(max-width:520px){.hero .art{width:100px}.hero h2{font-size:18px}.fe{font-size:24px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
.risk{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.stats .card:nth-child(1){background:linear-gradient(135deg,rgba(246,177,122,.38),rgba(240,143,180,.2)),var(--card)}
.stats .card:nth-child(2){background:linear-gradient(135deg,rgba(240,143,180,.34),rgba(165,149,230,.22)),var(--card)}
.stats .card:nth-child(3){background:linear-gradient(135deg,rgba(165,149,230,.36),rgba(125,184,232,.22)),var(--card)}
.stats .card:nth-child(4){background:linear-gradient(135deg,rgba(111,207,166,.34),rgba(125,184,232,.22)),var(--card)}
.bar i{background-image:linear-gradient(90deg,rgba(255,255,255,.4),rgba(255,255,255,0))!important}
input,select{background:linear-gradient(135deg,rgba(165,149,230,.1),rgba(125,184,232,.1)),var(--card)}
</style></head>
<body><div class="wrap">
<div id='auth' hidden><i class='fe' style='left:8%;top:12%'>💰</i><i class='fe' style='right:9%;top:18%;animation-delay:-2s'>📈</i><i class='fe' style='left:11%;bottom:10%;animation-delay:-4s'>🪙</i><i class='fe' style='right:8%;bottom:14%;animation-delay:-1s'>🎯</i><div class='ash'><div class='side'><div class='art'></div><div class='sh'>Take control of your money</div><p>Simple tracking, smart budgets and clear reports, all in one place.</p><ul><li>📊 Instant spending reports</li><li>🎯 Budgets with live alerts</li><li>💡 Saving and investing ideas</li></ul></div><div class='ac'><div style='text-align:center;margin-bottom:18px'><h2>Paisa Pilot</h2><p id='at' style='color:#8a84a3;margin:0'>Welcome back! Sign in to continue.</p></div><div class='tabs' id='atabs' style='display:flex;margin-bottom:16px'><button class='on' data-m='in' style='flex:1'>Sign in</button><button data-m='up' style='flex:1'>Create account</button></div><label id='ln' hidden>Name<input id='an' autocomplete='name' placeholder='Your name'></label><label>Email<input id='ae' type='email' autocomplete='email' placeholder='you@example.com'></label><label>Password<div class='pw'><input id='ap' type='password' autocomplete='current-password' placeholder='At least 6 characters'><button type='button' id='ase' aria-label='Show or hide password'>👁</button></div></label><div id='pm' hidden><div class='pwm'><i id='pb'></i></div><small id='pt'></small></div><p class='err' id='aer' role='alert'></p><button class='btn' id='ago'>Sign in</button><button class='btn ghost' id='ags' style='margin-top:10px'>Continue as guest</button></div></div></div>
<header>
 <div><h1>🧭 Paisa Pilot</h1><p class="sub" id="wel">Track spending, find savings, plan investments.</p></div>
 <div class="row" style="margin:0"><button class="btn ghost" id="theme">Dark / light</button><button class="btn ghost" id="sample">Load sample data</button><button class='btn ghost' id='lo'>Log out</button><button class="btn ghost clr">Clear all</button></div>
</header>

<nav class='nav' id='nav'><a href='#dash'>🏠 Dashboard</a><a href='#tx'>🧾 History</a><a href='#bud'>🎯 Budgets</a><a href='#rep'>📊 Reports</a><a href='#set'>⚙️ Settings</a></nav>
<div class='card hero' id='hero'><div><h2 id='hg'></h2><p class='sub' id='hs' style='max-width:46ch'></p></div><div class='art'></div></div>
<div id='alerts'></div>
<div class="grid stats" id="stats"></div>
<section class='pg card' id='v-tx' hidden><div class='row'><h3>Transaction history</h3><button class='btn ghost' id='csv'>Export CSV</button></div><div class='fl'><input id='q' placeholder='Search notes or category' aria-label='Search'><select id='fc' aria-label='Category'></select><input type='month' id='fm' aria-label='Month'><select id='fs' aria-label='Sort'><option value='n'>Newest first</option><option value='o'>Oldest first</option><option value='h'>Highest amount</option></select></div><p class='sub' id='txs' style='margin-bottom:6px'></p><div id='txl'></div></section>
<section class='pg' id='v-bud' hidden><div class='card'><h3>Monthly budgets</h3><p class='sub' style='margin:4px 0 12px'>Set a limit for each category. Leave empty for no limit.</p><div class='fl' id='bf'></div></div><div class='card'><h3 style='margin-bottom:10px'>This month's progress</h3><div id='bp'></div></div></section>
<section class='pg' id='v-rep' hidden><div class='card'><div class='row' style='margin:0'><h3>Reports</h3><div class='tabs' id='rt'><button data-p='1' class='on'>This month</button><button data-p='3'>3 months</button><button data-p='12'>12 months</button></div></div></div><div class='grid stats' id='rs'></div><div class='grid' style='grid-template-columns:repeat(auto-fit,minmax(300px,1fr))'><div class='card'><h3 style='margin-bottom:10px'>By category</h3><div id='rc'></div></div><div class='card'><h3 style='margin-bottom:10px'>Spent by month</h3><div id='rm'></div></div></div><div class='card'><h3 style='margin-bottom:6px'>Top 5 expenses</h3><div id='rt5'></div></div></section>
<section class='pg card' id='v-set' hidden><h3 style='margin-bottom:12px'>Settings</h3><div class='fl'><label class='sub'>Currency<select id='scur'><option>₹</option><option>$</option><option>€</option><option>£</option></select></label><label class='sub'>Monthly income<input id='inc2' type='number' min='0'></label><label class='sub'>Risk profile<select id='risk2'><option value='low'>Low</option><option value='mid'>Medium</option><option value='high'>High</option></select></label><label class='sub'>Theme<select id='sth'><option value=''>Auto</option><option value='light'>Light</option><option value='dark'>Dark</option></select></label></div><h3 style='font-size:15px;margin:16px 0 8px'>Your data</h3><div class='row' style='justify-content:flex-start'><button class='btn ghost' id='bk'>Export backup</button><button class='btn ghost clr'>Clear all</button></div><div class='fl'><input type='file' id='imf' accept='.json' aria-label='Backup file'><textarea id='imp' rows='3' placeholder='or paste backup JSON here'></textarea></div><button class='btn' id='imb'>Import backup</button> <span class='sub' id='imm'></span></section>
<div class='card' id='exp' hidden><div class='row' style='margin:0 0 6px'><b>Export ready</b><button class='x' onclick="document.getElementById('exp').hidden=true">✕</button></div><p class='sub' style='font-size:13px;margin-bottom:6px'>If no download started, copy the text below.</p><textarea id='eo' readonly rows='5'></textarea></div>

<div class="grid main">
 <div class="grid" style="align-content:start">
  <section class="card">
   <h3 style="margin-bottom:12px">Add expense</h3>
   <form id="f">
    <div class="cats" id="cats"></div>
    <input id="amt" type="number" min="1" step="any" placeholder="Amount (₹)" required aria-label="Amount">
    <input id="date" type="date" required aria-label="Date">
    <input id="note" type="text" placeholder="Note (optional)" aria-label="Note">
    <button class="btn" type="submit">Add expense</button>
   </form>
  </section>
  <section class="card">
   <div class="row"><h3>Spending trend</h3>
    <div class="tabs" id="tabs"><button data-v="d" class="on">Daily</button><button data-v="m">Monthly</button><button data-v="y">Yearly</button></div></div>
   <div class="chart" id="chart"></div>
  </section>
  <section class="card"><div class='row'><h3>Recent expenses</h3><a href='#tx' class='btn ghost' style='text-decoration:none'>View all →</a></div><div id="list"></div></section>
 </div>

 <div class="grid" style="align-content:start">
  <section class="card">
   <h3 style="margin-bottom:10px">Monthly income</h3>
   <input id="inc" type="number" min="0" placeholder="e.g. 60000" aria-label="Monthly income in rupees">
   <p class="sub" style="font-size:13px;margin-top:6px">Used to size your savings and investment ideas.</p>
  </section>
  <section class="card"><div class='row' style='margin-bottom:10px'><h3>Where it goes (this month)</h3><a href='#bud' class='sub'>Budgets →</a></div><div id="break"></div></section>
  <section class="card">
   <div class="row"><h3>🤖 AI suggestions</h3>
    <div class="risk"><span class="sub">Risk:</span><select id="risk" style="width:auto" aria-label="Risk profile"><option value="low">Low</option><option value="mid" selected>Medium</option><option value="high">High</option></select></div></div>
   <h3 style="font-size:15px;margin:6px 0">Where to save</h3><div id="save"></div>
   <h3 style="font-size:15px;margin:12px 0 6px">Where to invest</h3><div id="inv"></div>
   <p class="sub" style="font-size:12px;margin-top:8px">Suggestions are generated from your own spending pattern. General guidance, not financial advice.</p>
  </section>
 </div>
</div>
</div>

<script>
const CATS=[
 {k:'food',n:'Food',i:'🍔',c:'#f6b17a',s:0},
 {k:'shop',n:'Shopping',i:'🛍️',c:'#f08fb4',s:1},
 {k:'travel',n:'Transport',i:'🚌',c:'#7db8e8',s:2},
 {k:'bills',n:'Bills',i:'💡',c:'#f2cb6b',s:3},
 {k:'rent',n:'Rent',i:'🏠',c:'#a595e6',s:4},
 {k:'health',n:'Health',i:'💊',c:'#6fcfa6',s:5},
 {k:'fun',n:'Fun',i:'🎬',c:'#f4917e',s:6},
 {k:'other',n:'Other',i:'📦',c:'#a9b2c3',s:7}];
const C=Object.fromEntries(CATS.map(c=>[c.k,c]));
const $=id=>document.getElementById(id);
const inr=n=>(S.cur||'₹')+Math.round(n).toLocaleString('en-IN');
let S={ex:[],inc:0,risk:'mid',bud:{},cur:'₹',theme:''},view='d',cat='food';
let SES='';try{SES=localStorage.getItem('pp_ses')||''}catch(e){}
const KEY=SES&&SES!=='guest'?'pp1_'+SES:'pp1';
try{const r=localStorage.getItem(KEY);if(r)S=Object.assign(S,JSON.parse(r))}catch(e){}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};
const iso=d=>d.toISOString().slice(0,10);
const tile=(k,size)=>{const c=C[k];return `<span class="ic s${c.s}" style="background:${c.c}33;color:${c.c}">${c.i}</span>`};

$('date').value=iso(new Date());$('inc').value=S.inc||'';$('risk').value=S.risk;
$('cats').innerHTML=CATS.map(c=>`<button type="button" class="cat" data-k="${c.k}"><span class="ic s${c.s}" style="background:${c.c}33">${c.i}</span>${c.n}</button>`).join('');
function markCat(){document.querySelectorAll('.cat').forEach(b=>b.classList.toggle('on',b.dataset.k===cat))}
$('cats').onclick=e=>{const b=e.target.closest('.cat');if(b){cat=b.dataset.k;markCat()}};markCat();

