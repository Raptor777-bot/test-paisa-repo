function chart(){
 const now=new Date();let data=[];
 if(view==='d'){for(let i=13;i>=0;i--){const d=new Date(now);d.setDate(now.getDate()-i);const k=iso(d);data.push([d.getDate()+'/'+(d.getMonth()+1),S.ex.filter(x=>x.d===k)])}}
 else if(view==='m'){for(let i=11;i>=0;i--){const d=new Date(now.getFullYear(),now.getMonth()-i,1);const k=iso(new Date(d.getTime()-d.getTimezoneOffset()*6e4)).slice(0,7);data.push([d.toLocaleString('en',{month:'short'}),S.ex.filter(x=>mkey(x.d)===k)])}}
 else{for(let i=3;i>=0;i--){const y=String(now.getFullYear()-i);data.push([y,S.ex.filter(x=>x.d.slice(0,4)===y)])}}
 const tot=data.map(d=>sum(d[1]));const max=Math.max(...tot,1);
 const W=Math.max(560,data.length*46),H=240,pb=28,pt=12;
 const bw=Math.min(30,(W-20)/data.length*.65);
 let s=`<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="Spending chart">`;
 [0,.5,1].forEach(f=>{const y=pt+(H-pb-pt)*(1-f);s+=`<line x1="0" x2="${W}" y1="${y}" y2="${y}" stroke="var(--line)"/><text x="2" y="${y-3}">${inr(max*f)}</text>`});
 data.forEach((d,i)=>{const x=10+i*((W-20)/data.length)+((W-20)/data.length-bw)/2;let y=H-pb;
  CATS.forEach(c=>{const v=sum(d[1].filter(e=>e.k===c.k));if(!v)return;const h=v/max*(H-pb-pt);y-=h;s+=`<rect x="${x}" y="${y}" width="${bw}" height="${h}" fill="${c.c}" rx="3"><title>${c.n}: ${inr(v)}</title></rect>`});
  s+=`<text x="${x+bw/2}" y="${H-10}" text-anchor="middle">${d[0]}</text>`});
 $('chart').innerHTML=s+'</svg>'+`<div class="risk" style="margin-top:6px">${CATS.map(c=>`<span class="sub" style="font-size:12px"><span style="color:${c.c}">●</span> ${c.n}</span>`).join('')}</div>`;
}

